{
  "manifest_version": 3,
  "name": "Chat Maestro",
  "short_name": "Maestro",
  "description": "Organize conversas de ChatGPT e Gemini, prompts, busca e exportação com privacidade e segurança.",
  "version": "0.3.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Chat Maestro"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
