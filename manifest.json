{
  "manifest_version": 3,
  "name": "Chat Maestro",
  "short_name": "Maestro",
  "description": "Organização contextual, biblioteca local, prompts e fila para ChatGPT e Gemini (prévia).",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Chat Maestro",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ]
}
