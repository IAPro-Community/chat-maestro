{
  "name": "chat-maestro",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Chat Maestro: extensão MV3 leve para organização, prompts e filas no ChatGPT e Gemini.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/assets.mjs && node scripts/verify.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "npm test && node scripts/package.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
